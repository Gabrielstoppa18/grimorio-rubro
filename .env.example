# Copie para .env.local e preencha com os dados do seu projeto Supabase
# (Project Settings → API). Sem essas variáveis o app roda só no navegador.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anon-publica

# Opcional: botões extras de login, se ativados em Authentication → Providers
# VITE_AUTH_PROVIDERS=google,discord
